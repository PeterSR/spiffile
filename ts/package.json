{
  "name": "spiffile",
  "version": "0.1.0",
  "description": "SPIFFE identities delivered as files — JWT-SVIDs and trust bundles without agents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterSR/spiffile.git",
    "directory": "ts"
  },
  "bugs": "https://github.com/PeterSR/spiffile/issues",
  "homepage": "https://github.com/PeterSR/spiffile#readme",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/test/*.test.js\""
  },
  "keywords": [
    "spiffe",
    "jwt-svid",
    "workload-identity",
    "service-to-service",
    "zero-trust"
  ],
  "devDependencies": {
    "@types/node": "^25",
    "typescript": "^5.6"
  }
}
